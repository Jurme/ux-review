# Supabase pooled connection for Vercel. Use the Transaction pooler string (port 6543).
# The Vercel Supabase integration sets POSTGRES_URL for you.
POSTGRES_URL=
# Optional direct connection. The app uses POSTGRES_URL.
POSTGRES_URL_NON_POOLING=
# Session signing secret. Set a long random value in Vercel.
AUTH_SECRET=
